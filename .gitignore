
# ====================================
# WORDPRESS SPECIFIC
# ====================================

# WordPress core files (keep only plugins/themes you customize)
/wordpress-data/wp-admin/
/wordpress-data/wp-includes/
/wordpress-data/wp-content/languages/
/wordpress-data/wp-content/upgrade/
/wordpress-data/wp-content/uploads/
/wordpress-data/*.php
/wordpress-data/.htaccess
/wordpress-data/license.txt
/wordpress-data/readme.html
/wordpress-data/wp-config-sample.php

# Keep custom plugins and themes structure
!/wordpress-data/wp-content/plugins/.gitkeep
!/wordpress-data/wp-content/themes/.gitkeep
!/wordpress-data/wp-content/mu-plugins/
!/wordpress-data/wp-content/themes/custom-theme/
!/wordpress-data/wp-content/plugins/custom-plugin/

# WordPress uploads (keep structure)
/wordpress-data/wp-content/uploads/
!/wordpress-data/wp-content/uploads/.gitkeep

# WordPress cache
/wordpress-data/wp-content/cache/
/wordpress-data/wp-content/w3tc-config/

# ====================================
# DOCKER & ENVIRONMENT
# ====================================

# Environment variables (keep .env.example)
.env
.env.local
.env.production
!.env.example
!.env.template

# Docker volumes and data
/database-data/
/mysql_data/
/postgres_data/
/redis_data/

# Docker logs
*.log

# ====================================
# DATABASES
# ====================================

*.dump
*.backup

# SQLite
*.sqlite
*.sqlite3
*.db

# ====================================
# LOGS
